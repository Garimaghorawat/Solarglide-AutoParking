# SolarGlide Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# AUTH_SECRET — required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters. The server will refuse to start if this is missing.
# DO NOT commit this file to version control.
AUTH_SECRET=REPLACE_WITH_YOUR_GENERATED_SECRET

# Razorpay credentials (replace with your actual keys)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
